(defcfg
  ;; Place your OS specific configurations here.
  ;; refs: https://github.com/jtroo/kanata/

)

;; for '60% Row-Staggered ANSI' keyboard - (1)
(defsrc
  esc         1           2           3           4           5           6           7           8           9           0           -           =           bspc
  tab         q           w           e           r           t           y           u           i           o           p           [           ]           \
  caps        a           s           d           f           g           h           j           k           l           ;           '                       ret
  lsft        z           x           c           v           b           n           m           ,           .           /                                   rsft
  lctl        lmet        lalt                                            spc                                             ralt        fn          menu        rctl
)

;; omniflow keyboard-layout for (1)
(deflayer omniflow
  esc         1           2           3           4           5           6           7           8           9           0           -           =           bspc
  tab         b           l           d           w           q           j           f           o           u           ;           [           ]           \
  lctl        n           r           t           s           g           y           h           a           e           i           '                       ret
  lsft        z           x           c           v           m           k           p           ,           .           /                                   rsft
  caps        lalt        lmet                                            spc                                             ralt        fn          menu        rctl
)
